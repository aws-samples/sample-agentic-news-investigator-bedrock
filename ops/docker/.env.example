# Copy to ops/docker/.env and fill in from your stack's outputs. Compose reads
# this file for ${...} interpolation in compose.yml. Never put credentials here:
# AWS access comes from a mounted ~/.aws profile, the invoking shell's
# AWS_ACCESS_KEY_ID/... environment, or a task/instance role. Do not commit .env.

AWS_REGION=us-east-1
# Profile inside the mounted FIN_AWS_DIR; leave empty when using environment
# credentials or a role.
AWS_PROFILE=
# Host directory mounted read-only at /home/nonroot/.aws.
FIN_AWS_DIR=~/.aws

# Per-arm plumbing (CDK stack outputs).
FIN_V2_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/fin-v2-news
FIN_V2_TABLE=fin-v2-trading
FIN_V3_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/fin-v3-news
FIN_V3_TABLE=fin-v3-trading

# Shared by every arm.
FIN_TAPE_TABLE=fin-quote-tape
FIN_TRANSCRIPT_BUCKET=<transcript-bucket-name>

# SEC fair-access policy requires an identifying contact on EDGAR requests.
FIN_EDGAR_CONTACT=you@example.org

# true = decide and audit only, no paper fills (the code default).
FIN_DRY_RUN=true
FIN_MAX_INVESTIGATIONS_PER_DAY=20
