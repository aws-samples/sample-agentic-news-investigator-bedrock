# fin v2/v3 worker environment — generated by scripts/oss/gen-env-example.sh from v2/src; do not edit by hand.
# Export these in the worker's environment (shell, or the service manager's unit file); nothing loads a
# .env file automatically. A blank value means there is no default; otherwise the value shown is what the
# code applies when the variable is unset.
# Defaults and the incidents that set them are documented next to each knob in v2/src/config.ts.

# ---- v2/src/config.ts
# AWS region for every SDK client (DynamoDB, SQS, S3, SSM, Bedrock).
AWS_REGION=us-east-1
# SQS queue the worker long-polls for NewsItem events (FinStack output). Required by the worker.
V2_QUEUE_URL=
# S3 bucket for full agent transcripts (FinStack output). Required by the worker.
V2_TRANSCRIPT_BUCKET=
# Decide and audit but never fill (the default); set to false to let paper fills into the book happen.
V2_DRY_RUN=true
# Bedrock model id for Haiku triage (and filing summaries).
V2_TRIAGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Triage materiality at or above which a story is investigated.
V2_TRIAGE_THRESHOLD=0.45
# Lower bar for news that touches an instrument we hold.
V2_HELD_TRIAGE_THRESHOLD=0.35
# Set to 'on' for yield-aware triage: per-category bars from STATE/YIELD (npm run yield -- --write). Off by default; bench first.
V2_YIELD_TRIAGE=
# Yield triage: half-life (days) of the decay weight on each category's cost and P&L.
V2_YIELD_HALF_LIFE_DAYS=7
# Yield triage: pseudo-observations shrinking a category's yield toward the global yield.
V2_YIELD_MIN_N=20
# Yield triage: a decision counts toward P&L only once this old (so its 7-day score exists).
V2_YIELD_MATURITY_DAYS=8
# Yield triage: most a category's bar may move from V2_TRIAGE_THRESHOLD, either way.
V2_YIELD_MAX_SHIFT=0.20
# Yield triage: lowest bar any category can reach.
V2_YIELD_FLOOR=0.30
# Yield triage: highest bar any category can reach.
V2_YIELD_CEIL=0.80
# Yield triage: sub-bar items admitted per category per day so no category starves.
V2_YIELD_EXPLORATION_PER_DAY=3
# Yield triage: minutes between the worker's re-reads of STATE/YIELD.
V2_YIELD_REFRESH_MIN=60
# Position watcher: a new leg of this size triggers a re-evaluation.
V2_WATCH_MOVE_PCT=5
# Position watcher: leg size (percent) that triggers a re-evaluation for prediction contracts.
V2_WATCH_MOVE_PREDICTION_PCT=10
# Position watcher: hours before the same position may raise another alert.
V2_WATCH_COOLDOWN_HOURS=4
# Position watcher: a move only counts as an alert when the venue shows at least this much resting depth (USD).
V2_WATCH_MIN_DEPTH_USD=500
# Position watcher: a move only counts as an alert when the spread is no wider than this fraction of the mid.
V2_WATCH_MAX_SPREAD_FRAC=0.25
# Defer the daily review while every position was re-underwritten this recently...
V2_REVIEW_SKIP_IF_FRESH_MIN=60
# ...but never past this many hours after the review hour.
V2_REVIEW_GRACE_HOURS=3
# FX majors: above this spread (bps) the venue's fiat book is ignored in favour of the interbank reference rate.
V2_FX_MAX_SPREAD_BPS=10
# Daily whole-book review fires at this UTC hour.
V2_REVIEW_HOUR_UTC=13
# Parked (at-open / limit) orders expire after this many hours.
V2_PENDING_EXPIRY_HOURS=24
# Working reduce-only orders: minutes between successive 25%-of-book slices of a liquidity-capped exit.
V2_PENDING_SLICE_MIN=60
# News investigations stop at (1 - reserve) of the daily budget; position management (alerts, daily review) may spend the reserve.
V2_BUDGET_RESERVE_FRACTION=0.2
# Identical headlines within this window are skipped before triage.
V2_DEDUPE_HOURS=3
# Liquidity realism: a paper fill may take at most this fraction of the venue's resting book (prediction markets report it).
V2_MAX_FILL_LIQUIDITY_FRACTION=0.25
# Drop queued news older than this many hours instead of investigating it.
V2_MAX_NEWS_AGE_HOURS=6
# Agent SDK turn budget per investigation.
V2_MAX_TURNS=15
# Agent SDK spend ceiling per investigation, USD.
V2_MAX_BUDGET_PER_RUN_USD=3
# v3 only: minutes between curiosity passes over the world model.
V2_CURIOSITY_INTERVAL_MIN=60
# v3 only: hours before the same curiosity trigger may fire again.
V2_CURIOSITY_COOLDOWN_HOURS=6
# REQUIRED for read_source: contact email in the SEC EDGAR User-Agent (fair-access policy). No fallback.
V2_EDGAR_CONTACT=
# Alternative name for V2_EDGAR_CONTACT (the CDK stack passes this one to v1's poller).
EDGAR_CONTACT=
# Amazon Bedrock guardrail id (FinStack output GuardrailId); set it together with V2_GUARDRAIL_VERSION, or leave both unset for no...
V2_GUARDRAIL_ID=
# Published guardrail version (FinStack output GuardrailVersion), never DRAFT in production.
V2_GUARDRAIL_VERSION=
# Per-call bound on one ApplyGuardrail screen of a tool result, in ms.
V2_GUARDRAIL_SCREEN_TIMEOUT_MS=8000
# Deployment mandate: lower edge of the deployed-equity band (fraction).
V2_MANDATE_MIN_DEPLOYED=0.30
# Deployment mandate: upper edge of the deployed-equity band (fraction).
V2_MANDATE_MAX_DEPLOYED=0.70
# Deployment mandate: cap on any single position as a fraction of equity.
V2_MANDATE_MAX_POSITION=0.10
# Deployment mandate: how far back the watchlist of previously-named instruments reaches.
V2_MANDATE_WATCHLIST_HOURS=72
# Web search backend for the investigator: "nova" (Amazon Nova web grounding on Bedrock — AWS credentials only) or "off" (degraded mode).
V2_WEB_SEARCH=nova
# Opt-in data sources (sources.ts), comma-separated: `yahoo`, `kalshi`, `coinbase`, `polymarket`.
V2_ENABLE_SOURCES=
# Grounding is US-CRIS-only, hence the `us.` inference profile.
V2_SEARCH_MODEL=us.amazon.nova-2-lite-v1:0
# One grounded call ran 10 s in the 2026-09-04 probe; a request may run several searches.
V2_SEARCH_TIMEOUT_MS=60000
# Reasoning effort for the daily letter's narrative (low | medium | high | xhigh | max); unset = the API default (high).
V2_LETTER_EFFORT=
# Per-model pricing (pricing.ts).
V2_MODEL_RATES_JSON=
# Meter Haiku triage and filing enrichment into the daily spend breaker.
V2_METER_TRIAGE=

# ---- read directly by other modules (reporting and operations, never the decision path)
# Load the registry: an explicit `file`, else `V2_ARMS_FILE`, else the repo's arms.json, else the built-in default. [v2/src/arms.ts]
V2_ARMS_FILE=
# Which arm this process is (v2 = unassisted control, v3 = world model); prefixes logs and transcripts. [v2/src/arms.ts]
V2_ARM=
# Investigator reasoning effort (low | medium | high | xhigh | max); unset = the arm's effort in arms.json, else the SDK default (high). [v2/src/arms.ts]
V2_EFFORT=
# DynamoDB table for this arm's paper book, audit rows, theses and scores. [v2/src/arms.ts]
V2_TABLE=
# DynamoDB quote tape shared by every arm: each observed price, stamped when observed, so the bench can price as-of an event. [v2/src/arms.ts]
V2_TAPE_TABLE=
# SSM parameter the worker polls; any value other than 'off' halts this arm. [v2/src/arms.ts]
V2_KILL_SWITCH_PARAM=
# SSM parameter holding this arm's daily LLM spend cap in USD. [v2/src/arms.ts]
V2_DAILY_BUDGET_PARAM=
# Bedrock model id the Agent SDK investigator runs on. [v2/src/arms.ts]
V2_MASTER_MODEL=
# Set to 1 for the v3 arm: typed, gated world model shared across investigations plus the hourly curiosity loop. [v2/src/arms.ts]
V2_WORLD_MODEL=
# Per-day cap on investigations, independent of the dollar budget. [v2/src/arms.ts]
V2_MAX_INVESTIGATIONS_PER_DAY=
# ISO timestamp the book went live; anchors return-since-inception and the benchmark window. [v2/src/arms.ts]
V2_INCEPTION=
# YYYY-MM-DD: regenerate that day's letter instead of today's (never advances the letter anchor). [v2/src/daily-report.ts]
REPORT_DAY=
# Extra tool directories (pandoc, weasyprint) come from the operator: V2_TOOL_PATH, else HOMEBREW_PREFIX/bin when set. [v2/src/daily-report.ts]
V2_TOOL_PATH=
# Set to 1 to send the daily letter's narrative PDF to a printer after generating it. [v2/src/daily-report.ts]
V2_PRINT=
# CUPS printer name for V2_PRINT; unset = the system default printer. [v2/src/daily-report.ts]
V2_PRINTER=
# Dashboard to export from (npm run dashboard:export); unset = http://127.0.0.1:<V2_DASHBOARD_PORT>. [v2/src/dashboard-export.ts]
V2_DASHBOARD_URL=
# Loopback port the read-only dashboard listens on. [v2/src/dashboard-export.ts]
V2_DASHBOARD_PORT=4310
# Seconds between dashboard snapshot refreshes while a page is open. [v2/src/dashboard.ts]
V2_DASHBOARD_REFRESH_SECS=90
# Service manager the dashboard reports worker health from (launchd | systemd | none); unset = launchd on macOS, none elsewhere. [v2/src/dashboard.ts]
V2_SUPERVISOR=
# Path of the v2 worker log the dashboard tails for health; unset = the supervisor's default location. [v2/src/dashboard.ts]
V2_WORKER_LOG=
# Worker log path template for arms other than the focus arm (<prefix>, <key>); unset = the supervisor's default. [v2/src/dashboard.ts]
V2_WORKER_LOG_PATTERN=
# Directory holding weasyprint's native libraries (glib/pango/cairo) when the dynamic loader cannot find them. [v2/src/print.ts]
V2_WEASYPRINT_LIB_DIR=
# Path to the weasyprint binary when it is not on PATH or in a common prefix. [v2/src/print.ts]
V2_WEASYPRINT=
# Command V2_PRINT runs with the PDF path as its only argument, on any platform; unset = /usr/bin/lp on macOS, nothing elsewhere. [v2/src/print.ts]
V2_PRINT_CMD=
# Bench (archive mode): EventBridge bus the replay reads; unset = <prefix>-events. [v2/src/replay.ts]
V2_EVENT_BUS=
# Bench (archive mode): the disabled rule a replay targets; unset = <prefix>-replay-rule. [v2/src/replay.ts]
V2_REPLAY_RULE=
# Bench (archive mode): SQS queue the replay drains; unset = <prefix>-replay. [v2/src/replay.ts]
V2_REPLAY_QUEUE=
# Bench (archive mode): EventBridge archive replayed from; unset = <prefix>-events-archive. [v2/src/replay.ts]
V2_EVENT_ARCHIVE=
# Bench only: guardrail id for the `guardrail` variant (replay.ts sets it from --guardrail-id); nothing else reads it. [v2/src/replay.ts]
V2_BENCH_GUARDRAIL_ID=
# Bench only: guardrail version for the `guardrail` variant (replay.ts sets it from --guardrail-version). [v2/src/replay.ts]
V2_BENCH_GUARDRAIL_VERSION=
# DynamoDB table of the v3 (world-model) arm, read by the A/B report and the dashboard. [v2/src/yield.ts]
V3_TABLE=fin-v3-trading
